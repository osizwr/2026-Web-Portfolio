# Copy this file to .env.local and fill in your own values.
# Everything here is NEXT_PUBLIC_*, meaning it is inlined into the browser
# bundle at build time — never put secrets or API keys in this file.
# After changing any value, restart the dev server to pick it up.

# --- Identity -----------------------------------------------------------
# Shown in the sidebar and the browser tab title.
NEXT_PUBLIC_SITE_NAME=""
# Canonical URL of the deployed site, e.g. https://name.dev
NEXT_PUBLIC_SITE_URL=""

# --- Social links -------------------------------------------------------
# Address only — the Gmail row turns it into a mailto: link.
NEXT_PUBLIC_EMAIL=""
# Full profile URLs, e.g. https://github.com/name
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# --- GitHub contribution graph ------------------------------------------
# Username only, not a URL. Leave empty to hide nothing — the panel will
# simply show an error asking for it.
NEXT_PUBLIC_GITHUB_USERNAME=""

# --- Contact form -------------------------------------------------------
# Where the form POSTs. A Formspree endpoint (https://formspree.io/f/xxxx)
# works as-is. Leave empty and the form only shows a local confirmation
# without sending anything.
NEXT_PUBLIC_CONTACT_ENDPOINT=""
